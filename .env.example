# --- Environment separation ---
# Use separate values per environment: dev / staging / prod
APP_ENV=dev

# --- Database ---
# Managed Postgres connection string (use pooling for serverless/scale)
DATABASE_URL="postgresql://teira:teira@localhost:55432/teira?schema=public"
# (Alternative managed DB) DATABASE_URL="postgresql://user:password@host:5432/teira?schema=public"

# --- Supabase (Auth + optional Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage adapter ---
# local | supabase
STORAGE_PROVIDER=local
SUPABASE_STORAGE_BUCKET=teira-assets

# --- Observability ---
SENTRY_DSN=

# --- App ---
# Used for absolute URLs in links (optional)
PUBLIC_APP_URL=http://localhost:3000
